// Explicit scalar-argument ABI entry points for callback-bearing APIs. The
// callback-info structs are expanded into machine-word arguments so hikec can
// generate the Windows amd64 stack layout instead of treating the aggregate as
// a Go pointer.
cfunc instanceRequestAdapterScalarABI(instance *byte, options *byte, nextInChain uintptr, mode uintptr, callback uintptr, userdata1 uintptr, userdata2 uintptr) uint64 = wgpuInstanceRequestAdapter
cfunc adapterRequestDeviceScalarABI(adapter *byte, descriptor *byte, nextInChain uintptr, mode uintptr, callback uintptr, userdata1 uintptr, userdata2 uintptr) uint64 = wgpuAdapterRequestDevice
cfunc devicePopErrorScopeScalarABI(device *byte, nextInChain uintptr, mode uintptr, callback uintptr, userdata1 uintptr, userdata2 uintptr) = wgpuDevicePopErrorScope
cfunc bufferMapAsyncScalarABI(buffer *byte, mode uintptr, offset uintptr, size uintptr, nextInChain uintptr, callbackMode uintptr, callback uintptr, userdata1 uintptr, userdata2 uintptr) = wgpuBufferMapAsync

// Typed callback-info entry points.  CallbackInfoWire is the source-level
// type for the five-word callback record; only the final native trampoline
// expands it into scalar Windows amd64 arguments.
cfunc c_InstanceRequestAdapterABI(instance *byte, options *byte, info CallbackInfoWire) uint64 {
    return instanceRequestAdapterScalarABI(instance, options, info.NextInChain, info.Mode, info.Callback, info.Userdata1, info.Userdata2)
}

cfunc InstanceRequestAdapterABI(instance *byte, options *byte, info CallbackInfoWire) uint64 = c_InstanceRequestAdapterABI

cfunc c_AdapterRequestDeviceABI(adapter *byte, descriptor *byte, info CallbackInfoWire) uint64 {
    return adapterRequestDeviceScalarABI(adapter, descriptor, info.NextInChain, info.Mode, info.Callback, info.Userdata1, info.Userdata2)
}

cfunc AdapterRequestDeviceABI(adapter *byte, descriptor *byte, info CallbackInfoWire) uint64 = c_AdapterRequestDeviceABI

cfunc c_DevicePopErrorScopeABI(device *byte, info CallbackInfoWire) {
    devicePopErrorScopeScalarABI(device, info.NextInChain, info.Mode, info.Callback, info.Userdata1, info.Userdata2)
}

cfunc DevicePopErrorScopeABI(device *byte, info CallbackInfoWire) = c_DevicePopErrorScopeABI

cfunc c_BufferMapAsyncABI(buffer *byte, mode uintptr, offset uintptr, size uintptr, info CallbackInfoWire) {
    bufferMapAsyncScalarABI(buffer, mode, offset, size, info.NextInChain, info.Mode, info.Callback, info.Userdata1, info.Userdata2)
}

cfunc BufferMapAsyncABI(buffer *byte, mode uintptr, offset uintptr, size uintptr, info CallbackInfoWire) = c_BufferMapAsyncABI

