cfunc RenderPassEncoderEnd(pass *byte) = wgpuRenderPassEncoderEnd
cfunc RenderPassEncoderRelease(pass *byte) = wgpuRenderPassEncoderRelease
cfunc CommandEncoderFinish(encoder *byte, descriptor *byte) *byte = wgpuCommandEncoderFinish
cfunc CommandEncoderRelease(encoder *byte) = wgpuCommandEncoderRelease
cfunc CommandBufferRelease(buffer *byte) = wgpuCommandBufferRelease
cfunc QueueSubmit(queue *byte, commandCount uint64, commands *byte) = wgpuQueueSubmit
cfunc QueueRelease(queue *byte) = wgpuQueueRelease

// Callback state and native C-ABI entries used by the Go wrapper. These are
// intentionally kept in this file so one Hike source unit produces the one
// native SXSO used by this package.
type WGPUStringView struct {
	Data uintptr
	Length uintptr
}

type RequestAdapterCallbackState struct {
	Status uintptr
	Adapter uintptr
	MessageData uintptr
	MessageLength uintptr
	Done uintptr
}

cfunc c_WGPUStaticRequestAdapterCallback(status int, adapter *byte, messageView *WGPUStringView, state *RequestAdapterCallbackState, _ *byte) {
	state.Status = status
	state.Adapter = adapter
	state.MessageData = messageView.Data
	state.MessageLength = messageView.Length
	state.Done = 1
}

type RequestDeviceCallbackState struct {
	Status uintptr
	Device uintptr
	MessageData uintptr
	MessageLength uintptr
	Done uintptr
}

cfunc WGPUStaticRequestAdapterCallback(status int, adapter *byte, messageView *WGPUStringView, state *RequestAdapterCallbackState, _ *byte) {
	state.Status = status
	state.Adapter = adapter
	state.MessageData = messageView.Data
	state.MessageLength = messageView.Length
	state.Done = 1
}

cfunc c_WGPUStaticRequestDeviceCallback(status int, device *byte, messageView *WGPUStringView, state *RequestDeviceCallbackState, _ *byte) {
	state.Status = status
	state.Device = device
	state.MessageData = messageView.Data
	state.MessageLength = messageView.Length
	state.Done = 1
}

cfunc WGPUStaticRequestDeviceCallback(status int, device *byte, messageView *WGPUStringView, state *RequestDeviceCallbackState, _ *byte) {
	state.Status = status
	state.Device = device
	state.MessageData = messageView.Data
	state.MessageLength = messageView.Length
	state.Done = 1
}

// Address accessors for the native callback trampolines.
extern func RequestAdapterCallbackPtr() uintptr = WGPUStaticRequestAdapterCallback
extern func RequestDeviceCallbackPtr() uintptr = WGPUStaticRequestDeviceCallback

