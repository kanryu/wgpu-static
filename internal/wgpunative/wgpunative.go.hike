// Native logging.
extern func wgpuSetLogCallback(callback *byte, userdata *byte)
extern func wgpuSetLogLevel(level uint32)
extern func wgpuGetVersion() uint32

// Backend-native Metal handles. The returned pointers are borrowed.
extern func wgpuDeviceGetNativeMetalDevice(device *byte) *byte
extern func wgpuQueueGetNativeMetalCommandQueue(queue *byte) *byte
extern func wgpuTextureGetNativeMetalTexture(texture *byte) *byte

