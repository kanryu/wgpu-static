// WebGPU native C ABI declarations for Hike.
//
// This file mirrors the wgpu-native extensions declared by
// third_party/wgpu-native/ffi/wgpu.h.  The standard WebGPU declarations are
// provided by ffi/webgpu-headers/webgpu.h and use the same ABI conventions.
//
// ABI mapping used here:
//   - WGPU handles, structures, callbacks and strings: *byte
//   - WGPUBool and C enum/flags values: uint32 (flags wider than 32 bits use uint64)
//   - size_t, uint64_t and WGPUSubmissionIndex: uint64
//   - C float: float32
package wgpunative

// CallbackInfoWire is the five-word Windows x64 ABI record shared by the
// generated trampolines and the higher-level wgpu package.
type CallbackInfoWire struct {
    NextInChain uintptr
    Mode uintptr
    Callback uintptr
    Userdata1 uintptr
    Userdata2 uintptr
}

// Callback descriptors mirrored from the wgpu package.  Keeping these
// layouts in the Hike source makes the callback-bearing device descriptor
// fields explicit and keeps their Windows amd64 ABI representation visible
// next to CallbackInfoWire.
type RequestDeviceCallbackInfo struct {
    NextInChain uintptr
    Mode uintptr
    Callback uintptr
    Userdata1 uintptr
    Userdata2 uintptr
}

type DeviceLostCallbackInfo struct {
    NextInChain uintptr
    Mode uintptr
    Callback uintptr
    Userdata1 uintptr
    Userdata2 uintptr
}

type UncapturedErrorCallbackInfo struct {
    NextInChain uintptr
    Callback uintptr
    Userdata1 uintptr
    Userdata2 uintptr
}


// Core WebGPU entry points used by the static triangle path. Descriptor and
// callback-info values are passed as pointers to their C-layout storage; this
// is the Windows ABI representation used by wgpu-native for these aggregates.
extern func wgpuCreateInstance(descriptor *byte) *byte
extern func wgpuInstanceRelease(instance *byte)
extern func wgpuInstanceProcessEvents(instance *byte)
extern func wgpuInstanceCreateSurface(instance *byte, descriptor *byte) *byte
extern func wgpuInstanceRequestAdapter(instance *byte, options *byte, callbackInfo *byte) uint64
extern func wgpuAdapterRelease(adapter *byte)
extern func wgpuAdapterRequestDevice(adapter *byte, descriptor *byte, callbackInfo *byte) uint64
extern func wgpuDeviceRelease(device *byte)
extern func wgpuDeviceGetQueue(device *byte) *byte
extern func wgpuDeviceCreateShaderModule(device *byte, descriptor *byte) *byte
extern func wgpuShaderModuleRelease(shaderModule *byte)
extern func wgpuDeviceCreatePipelineLayout(device *byte, descriptor *byte) *byte
extern func wgpuPipelineLayoutRelease(layout *byte)
extern func wgpuSurfaceGetCapabilities(surface *byte, adapter *byte, capabilities *byte) uint32
extern func wgpuSurfaceCapabilitiesFreeMembers(capabilities *byte)
extern func wgpuSurfaceConfigure(surface *byte, config *byte)
extern func wgpuSurfaceGetCurrentTexture(surface *byte, texture *byte)
extern func wgpuSurfacePresent(surface *byte)
extern func wgpuSurfaceRelease(surface *byte)
extern func wgpuTextureCreateView(texture *byte, descriptor *byte) *byte
extern func wgpuTextureViewRelease(view *byte)
extern func wgpuTextureRelease(texture *byte)
extern func wgpuDeviceCreateRenderPipeline(device *byte, descriptor *byte) *byte
extern func wgpuRenderPipelineRelease(pipeline *byte)
extern func wgpuDeviceCreateCommandEncoder(device *byte, descriptor *byte) *byte
extern func wgpuCommandEncoderBeginRenderPass(encoder *byte, descriptor *byte) *byte
extern func wgpuRenderPassEncoderSetPipeline(pass *byte, pipeline *byte)
extern func wgpuRenderPassEncoderDraw(pass *byte, vertexCount uint32, instanceCount uint32, firstVertex uint32, firstInstance uint32)
extern func wgpuRenderPassEncoderEnd(pass *byte)
extern func wgpuRenderPassEncoderRelease(pass *byte)
extern func wgpuCommandEncoderFinish(encoder *byte, descriptor *byte) *byte
extern func wgpuCommandEncoderRelease(encoder *byte)
extern func wgpuCommandBufferRelease(buffer *byte)
extern func wgpuQueueSubmit(queue *byte, commandCount uint64, commands *byte)
extern func wgpuQueueRelease(queue *byte)

// Report and adapter enumeration.
extern func wgpuGenerateReport(instance *byte, report *byte)
extern func wgpuInstanceEnumerateAdapters(instance *byte, options *byte, adapters *byte) uint64

// Queue and device extensions.
extern func wgpuQueueSubmitForIndex(queue *byte, commandCount uint64, commands *byte) uint64
extern func wgpuQueueGetTimestampPeriod(queue *byte) float32
extern func wgpuDevicePoll(device *byte, wait uint32, submissionIndex *byte) uint32
